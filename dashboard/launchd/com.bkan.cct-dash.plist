<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- cct 대시보드 서버. 127.0.0.1:8790 에만 바인드하고, 테일넷 노출은 tailscale serve :8444 가 맡는다. -->
  <key>Label</key><string>com.bkan.cct-dash</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--script</string>
    <string>/Users/bkan/cct/dashboard/server.py</string>
    <string>--bind</string><string>127.0.0.1</string>
    <string>--port</string><string>8790</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/bkan/cct/dashboard</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>/Users/bkan</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/bkan/Library/Logs/cct-dash.log</string>
  <key>StandardErrorPath</key><string>/Users/bkan/Library/Logs/cct-dash.log</string>
</dict>
</plist>

